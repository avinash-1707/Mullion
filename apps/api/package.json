{
  "name": "@mullion/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@mullion/agents": "workspace:*",
    "@mullion/artifacts": "workspace:*",
    "@mullion/db": "workspace:*",
    "@mullion/delivery": "workspace:*",
    "@mullion/llm": "workspace:*",
    "@mullion/logger": "workspace:*",
    "@mullion/orchestrator": "workspace:*",
    "@mullion/otel": "workspace:*",
    "@mullion/sandbox": "workspace:*",
    "@mullion/schemas": "workspace:*",
    "@temporalio/client": "^1.24.0",
    "@temporalio/interceptors-opentelemetry": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "better-auth": "^1.7.6",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.10",
    "hono-rate-limiter": "^0.5.4",
    "jszip": "^3.10.2",
    "resend": "^6.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mullion/config": "workspace:*",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
