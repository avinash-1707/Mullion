# Neon pooled connection string
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin this API is served from (Better Auth baseURL)
API_ORIGIN=http://localhost:8787

# Marketing/auth Next.js origin, for CORS + trustedOrigins
WEB_ORIGIN=http://localhost:3000

# Dashboard Next.js origin (app. subdomain in prod), same CORS/CSRF standing
DASHBOARD_ORIGIN=http://localhost:3001

OPENROUTER_API_KEY=

PORT=8787

# Optional, dev/test only (loopback enforced): point the LLM client at a
# local mock instead of real OpenRouter — see ADR-11 for the Phase 3 replay
# cache this stands in for.
# OPENROUTER_BASE_URL=http://127.0.0.1:9876

# Email delivery (ADR-67): console logs the message (OTP included) locally;
# production must use resend (enforced at boot).
EMAIL_DRIVER=console
# RESEND_API_KEY=
# EMAIL_FROM=Mullion <auth@yourdomain.dev>

# Google login (ADR-65), soft-optional pair.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub LOGIN OAuth app (ADR-65) — minimal scope (read:user, user:email),
# SEPARATE from the repo-scoped delivery app below. Soft-optional pair.
# GITHUB_LOGIN_CLIENT_ID=
# GITHUB_LOGIN_CLIENT_SECRET=

# GitHub DELIVERY OAuth app (ADR-56), repo scope, link-only. Soft-optional.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
