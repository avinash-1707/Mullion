# Neon pooled connection string
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin this API is served from (Better Auth baseURL)
API_ORIGIN=http://localhost:8787

# Marketing/auth Next.js origin, for CORS + trustedOrigins
WEB_ORIGIN=http://localhost:3000

# Dashboard Next.js origin (app. subdomain in prod), same CORS/CSRF standing
DASHBOARD_ORIGIN=http://localhost:3001

OPENROUTER_API_KEY=

PORT=8787

# Optional, dev/test only (loopback enforced): point the LLM client at a
# local mock instead of real OpenRouter — see ADR-11 for the Phase 3 replay
# cache this stands in for.
# OPENROUTER_BASE_URL=http://127.0.0.1:9876
